---
source: tests/compatibility.rs
expression: "masked(json(&sandbox, &[\"status\", \"--json\"]))"
---
{
  "configFile": "[path]",
  "sessions": [
    {
      "defaultProfile": {
        "accountId": "111122223333",
        "roleName": "ReadOnly"
      },
      "kind": "sso-session",
      "name": "corp",
      "region": "us-west-2",
      "startUrl": "https://mock-example.awsapps.com/start",
      "syncBlock": {
        "exclude": [
          "*/AdministratorAccess"
        ],
        "include": [
          "payments-prod/*"
        ],
        "mode": "sso",
        "name": "{account}/{role}",
        "profiles": 1,
        "region": "eu-west-1"
      },
      "token": {
        "expiresAt": "[timestamp]",
        "refreshable": true,
        "registrationExpiresAt": "[timestamp]",
        "state": "valid"
      }
    }
  ]
}
